# Copy to backend/.env for local development. Never commit real credentials.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/postdate
# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Resend API key and a sender on your verified domain. Server-side only.
MAIL_API_KEY=
MAIL_FROM=
# Behind a reverse proxy, list only the actual trusted proxy IPs/CIDRs.
TRUST_PROXY=
# Cloudinary is required for ephemeral hosts such as Render's free preview.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional encrypted backup tooling: generate 32 random bytes as 64 hex digits.
BACKUP_ENCRYPTION_KEY=
# Distinct empty restore_test database, used only for recovery drills.
POSTDATE_RESTORE_TEST_URI=
