# Copy this to .env and fill in real values. Never commit .env itself.

# MongoDB connection string — local Mongo or an Atlas cluster
MONGO_URI=mongodb://127.0.0.1:27017/postdate

# Where the frontend runs (CORS). Vite's default.
CLIENT_URL=http://localhost:5173

PORT=5000

# Signs log-in tokens (backend/controllers/authController.js). Any long
# random string — e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# 🧪 TEMP: the one-time code VerificationModal accepts, until a real email
# service sends real ones. Defaults to 0000 if left blank.
TEMP_VERIFY_CODE=0000
